# store: TEXTO É VERSIONADO (§11.E)
# Apenas mídia e credenciais ficam fora.

# Mídia: binários — Cloudinary é fonte da verdade após upload (§11.L)
store/media/

# Packages: contêm cópias locais de mídia + brief simplificado;
# o brief canônico em store/briefs/ já está versionado, e a mídia tá no Cloudinary.
# Manter packages fora do git evita duplicação.
store/packages/

# Renders/previews: artefatos gerados (mesma natureza de store/media/) — cache local, não versionar
store/previews/
w-view/

# Secrets locais (cloudinary.env, open-design-basic-auth.txt, etc)
# NB: comentário só vale em linha própria — inline (.local/ # ...) vira parte do padrão e não casa nada.
.local/
# exceção: templates de env são versionados
!.local/*.example
.env
.env.local
*.local.yaml
*.local.json

# Logs
*.log

# OS / editors
.DS_Store
.idea/
.vscode/
content-radar-layout
# Artefatos do Playwright MCP — snapshots e downloads de sessão de teste.
.playwright-mcp/

# Cache de mídia por ambiente. É derivado: a fonte da verdade é o Cloudinary
# depois da escolha da arte, e o que está aqui pode ser rebaixado a qualquer
# momento. Fica fora de store/, que é a fotografia congelada da importação.
var/

# Build do Next na raiz — acontece quando alguém roda o build do diretório
# errado. O .gitignore de web/ não alcança aqui, e os arquivos de trace já
# entraram no repositório uma vez por isso.
.next/
