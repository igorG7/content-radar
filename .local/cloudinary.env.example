# Template do arquivo `.local/cloudinary.env` consumido pela skill `radar-handoff` (spec 007).
#
# Como ativar:
#   cp .local/cloudinary.env.example .local/cloudinary.env
#   chmod 600 .local/cloudinary.env
#   # preencha os valores reais (provisionados pelo owner no dashboard Cloudinary)
#
# `.local/` está em .gitignore — credenciais não vão pro git.
# Enquanto não houver credenciais reais, rode a skill com `--placeholder-mode`.

CLOUDINARY_CLOUD_NAME=<cloud-name-aqui>
CLOUDINARY_API_KEY=<api-key-aqui>
CLOUDINARY_API_SECRET=<api-secret-aqui>

# Opcional — sobrescreve manifest.cloudinary.folder
# CLOUDINARY_FOLDER=content-radar/avanz
