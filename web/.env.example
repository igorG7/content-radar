# Contrato de ambiente do app web. Copie para `.env.local` (desenvolvimento);
# o de produção é gerado por `scripts/papeis-de-producao.mts`, que sorteia as
# senhas e o segredo de sessão.
#
#   cp .env.example .env.local && chmod 600 .env.local
#
# `.env*` está no .gitignore. Este arquivo é a única exceção, e por isso não
# leva valor real nenhum.

# ── Banco ───────────────────────────────────────────────────────────────────
# Dois papéis, de propósito. A aplicação não tem posse das tabelas — é o que faz
# o row-level security valer para ela, já que o dono ignora política a menos que
# a tabela tenha FORCE (e as nossas têm).
DATABASE_URL=postgres://radar_app:<senha>@127.0.0.1:5432/radar_dev
DATABASE_URL_MIGRATIONS=postgres://radar_owner:<senha>@127.0.0.1:5432/radar_dev

# ── Sessão ──────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres, sem valor de fallback: a app **recusa subir** sem um.
# Fallback aqui seria um segredo conhecido publicando sessão de cliente.
#
#   node -e 'console.log(require("crypto").randomBytes(48).toString("base64url"))'
SESSION_SECRET=

# ── Cadastro público ────────────────────────────────────────────────────────
# Só "1" abre. Qualquer outro valor — inclusive "true" e "sim" — deixa fechado:
# quem digitou errado achou que tinha aberto, e o erro barato é o servidor novo
# nascer fechado em vez de virar torneira de ambientes.
CADASTRO_ABERTO=0

# ── Cloudinary ──────────────────────────────────────────────────────────────
# Conta única para as duas instalações. O que as separa é o FOLDER, que prefixa
# o public_id: sem ele o identificador é `<ambiente>/<brief>`, igual nos dois
# bancos — que saíram da mesma cópia — e o envio usa overwrite, então uma
# varredura em dev trocaria a imagem publicada do mesmo brief em produção.
#
# Faltando qualquer uma das três, o app segue inteiro e só não publica mídia.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=content-radar/dev

# ── Opcionais ───────────────────────────────────────────────────────────────
# Raiz do radar. O default é o pai do diretório de trabalho, o que vale quando
# se roda de dentro de `web/`; o pm2 declara explicitamente.
# RADAR_ROOT=/srv/apps/content-radar

# Teto global de varreduras simultâneas (default 3). Ainda é palpite — o custo
# medido é de US$ 5 a 7 e 21 a 26 minutos por varredura.
# RADAR_SCANS_SIMULTANEOS=3

# Intervalo do trabalhador entre olhadas na fila, em ms (default 5000).
# RADAR_TRABALHADOR_INTERVALO_MS=5000

# Força o backend de arquivo em vez do Postgres. Sem DATABASE_URL, é o default.
# RADAR_BACKEND=arquivo

# Rótulo do ambiente no backend de arquivo (default `avanz-imoveis`). Só vale
# ali: no Postgres o ambiente vem da sessão e é o que sustenta o RLS — mudar
# esta variável não move nada no banco.
# RADAR_AMBIENTE=avanz-imoveis
